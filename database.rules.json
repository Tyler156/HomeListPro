{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "properties": {
          ".indexOn": "createdAt"
        },
        "trades": {
          ".indexOn": "createdAt"
        },
        "problems": {
          ".indexOn": "createdAt"
        }
      }
    }
  }
}
