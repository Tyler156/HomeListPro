rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Issue photos are stored under users/{uid}/properties/... so the same
    // owner-only rule as the database applies. "read" also covers the download
    // URLs that getDownloadURL hands back.
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
